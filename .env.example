# Shared DB (Neon)
DATABASE_URL="__REQUIRED__"
DATABASE_URL_UNPOOLED="__REQUIRED__"

# App + auth
AUTH_SECRET="__REQUIRED__"
# JOB_API_TOKEN protects all /v1/jobs* endpoints when set.
# Leave blank only if those endpoints are intentionally unauthenticated.
JOB_API_TOKEN="__OPTIONAL_JOB_API_TOKEN__"
# Optional override specifically for web diagnostics proxy forwarding.
DIAGNOSTICS_PROXY_JOB_API_TOKEN="__OPTIONAL_DIAGNOSTICS_PROXY_TOKEN__"
NEXT_PUBLIC_WEB_URL="https://esg-rdt-master-pi.vercel.app"
NEXT_PUBLIC_API_URL="http://localhost:3001"
DIAGNOSTICS_PROXY_TENANT_ID="demo-tenant"

# Blob
BLOB_READ_WRITE_TOKEN="__REQUIRED_IF_BLOB_USED__"

# Optional cache
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
